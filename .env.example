# Path to your research repo (used unchanged as the mapping API)
LEGALCOMPASS_REPO=../sanhitabridge
# Shared key between the backend and the mapping API (avoids the 60 req/min anonymous limit)
LEGALCOMPASS_API_KEY=change-me
# Optional LLM for plain-language wording (explanation + related-judgment summaries). Leave empty for rule-only mode.
# A key alone is enough: xAI Grok keys start with "xai-", Groq keys with "gsk_"; the model is picked automatically.
LLM_API_KEY=
# Only for other OpenAI-compatible endpoints (Ollama: http://localhost:11434/v1) or to force a model:
LLM_BASE_URL=
LLM_MODEL=
